<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:id="@+id/main_content"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView style="@style/LabLabel" android:text="@string/lab_label" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/main_title" android:textSize="32sp" android:textStyle="bold"
            android:textColor="#101828" android:layout_marginTop="12dp" />
        <TextView style="@style/BodyText" android:text="@string/main_description"
            android:layout_marginTop="12dp" />
        <TextView style="@style/LabLabel" android:text="@string/explicit_label"
            android:layout_marginTop="32dp" />
        <TextView style="@style/BodyText" android:text="@string/explicit_description"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/open_second_button" style="@style/ActionButton"
            android:text="@string/open_second" />
        <TextView style="@style/LabLabel" android:text="@string/implicit_label"
            android:layout_marginTop="28dp" />
        <TextView style="@style/BodyText" android:text="@string/implicit_description"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/open_website_button" style="@style/ActionButton"
            android:text="@string/open_website" />
        <TextView style="@style/LabLabel" android:text="@string/optional_label"
            android:layout_marginTop="28dp" />
        <TextView style="@style/BodyText" android:text="@string/location_description"
            android:layout_marginTop="8dp" />
        <Button android:id="@+id/show_location_button" style="@style/ActionButton"
            android:text="@string/show_location" />
    </LinearLayout>
</ScrollView>
