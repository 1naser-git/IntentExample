<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IntentExample.Base" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#175CD3</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F7F9FC</item>
        <item name="android:statusBarColor">#F7F9FC</item>
        <item name="android:navigationBarColor">#101828</item>
    </style>
    <style name="Theme.IntentExample" parent="Theme.IntentExample.Base" />
    <style name="LabLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#175CD3</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>
    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#475467</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
    <style name="ActionButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:backgroundTint">#175CD3</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
</resources>
